# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID, same page under General Information
CLIENT_ID=

# Server (guild) ID to register the slash commands in.
# Right-click the server in Discord with Developer Mode on -> Copy Server ID.
# Leave empty to register globally instead (takes up to an hour to appear).
GUILD_ID=

# Optional: ID of the custom emoji to react with when someone says "michael".
# Type \:emojiname: in Discord and copy the number out of <:name:123456789>.
# Leave empty to disable the reaction.
MICHAEL_EMOJI_ID=
